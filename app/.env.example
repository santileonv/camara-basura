# Solo en Railway > servicio web > Variables, o en app/.env para desarrollo.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE
# Para Aiven, pegar el certificado CA completo, con sus saltos de linea.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_REQUIRE_TLS=true
CAMERA_TOKEN=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
DASHBOARD_PASSWORD=CAMBIAR_POR_UNA_CLAVE_DE_12_CARACTERES_O_MAS
SESSION_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
NODE_ENV=production
THRESHOLD=0.80
STALE_AFTER_SECONDS=90
# Railway inyecta PORT; no es necesario escribirlo en su panel.
# Solo para importacion opcional desde la base anterior. Quitar al terminar:
# SOURCE_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_ANTERIOR/BASE?sslmode=require
# SOURCE_DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Copia Railway -> Aiven: DATABASE_URL sigue siendo la base de origen.
# INGEST_PAUSED=true
# AIVEN_DATABASE_URL=postgresql://USUARIO:CLAVE@SERVICIO.aivencloud.com:PUERTO/defaultdb?sslmode=require
# AIVEN_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
